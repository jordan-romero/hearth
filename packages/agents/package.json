{
  "name": "@hearth/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "demo": "dotenv -e ../../.env -- tsx src/demo.ts",
    "link": "dotenv -e ../../.env -- tsx src/link.ts",
    "backfill:sources": "dotenv -e ../../.env -- tsx src/backfill-sources.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@deepgram/sdk": "^5.10.0",
    "@hearth/core": "workspace:*",
    "@hearth/db": "workspace:*",
    "@supabase/supabase-js": "^2.115.0",
    "mammoth": "^1.12.2",
    "pg-boss": "^12.30.0",
    "unpdf": "^1.8.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.13",
    "vitest": "^4.1.10"
  }
}
