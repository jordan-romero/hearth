{
  "name": "@hearth/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "demo": "dotenv -e ../../.env -- tsx src/demo.ts",
    "link": "dotenv -e ../../.env -- tsx src/link.ts",
    "backfill:sources": "dotenv -e ../../.env -- tsx src/backfill-sources.ts",
    "graph:build": "dotenv -e ../../.env -- tsx src/graph-backfill.ts",
    "graph:eval": "dotenv -e ../../.env -- tsx src/graph-eval.ts",
    "recap:characters": "dotenv -e ../../.env -- tsx src/character-recap-backfill.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@deepgram/sdk": "^5.13.0",
    "@hearth/core": "workspace:*",
    "@hearth/db": "workspace:*",
    "@supabase/supabase-js": "^2.117.2",
    "mammoth": "^1.13.0",
    "pg-boss": "^12.35.0",
    "unpdf": "^1.8.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
