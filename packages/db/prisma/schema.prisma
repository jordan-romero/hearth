// Hearth — campaign memory schema (Phase 0: the permission spine).
//
// Design notes live in docs/data-model.md. This migration ships identity +
// tenancy (partial) and the memory core. Transcripts, embeddings, recaps, maps,
// billing, etc. are added additively in their phases — this file is a deliberate
// SUBSET of that full model, not the whole thing.
//
// pgvector (embeddings) is intentionally NOT here yet — it arrives in Phase 1
// with retrieval, to keep this first migration clean on Supabase.

generator client {
  provider = "prisma-client" // Prisma 7 generator (no binary engine)
  output   = "../src/generated/prisma" // generates into the repo, not node_modules
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
  // Connection URLs live in prisma.config.ts (Prisma 7). At runtime the client
  // connects via the pg driver adapter using DATABASE_URL (pooled) directly.
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum MemberRole {
  DM
  PLAYER
}

/// Where a piece of knowledge came from — drives the two-tier permission rule.
enum KnowledgeSource {
  SESSION // happened at the table — fair game to the campaign
  DM_ADDED // authored/uploaded by the DM — gated until revealed
  PLAYER_NOTE // a player's private journal entry — visible to its author (+ DM) only
  CORRECTION // DM-approved canon fix — authoritative, outranks whatever it supersedes
}

/// How a DM_ADDED unit originated (provenance/trust). SESSION units are PLAYED.
enum KnowledgeOrigin {
  PLAYED
  AUTHORED
  GENERATED // NPC generator & friends
}

/// The broad visibility. Targeted reveals (party/character) live in KnowledgeGrant,
/// so there is a single source of truth. PUBLIC is reserved, unused today.
enum BaseVisibility {
  DM_ONLY
  EVERYONE
  PUBLIC
}

enum KnowledgeType {
  NPC
  LOCATION
  EVENT
  FACT
  LORE
  ITEM
  RELATIONSHIP // links two other units via subject/object
  THREAD // an open question / dangling plot
}

enum GrantScope {
  CHARACTER
  PARTY
}

enum RevealAction {
  REVEAL
  REVOKE
  CHANGE_VISIBILITY
}

enum CharacterStatus {
  ACTIVE
  RETIRED
  DEAD
}

enum GameSessionStatus {
  PLANNED
  ACTIVE
  COMPLETE
}

// ─── Identity & tenancy ──────────────────────────────────────────────────────

model Campaign {
  id         String   @id @default(cuid())
  name       String
  // Which TTRPG this table plays — a preset key, not an enum, so new systems don't
  // need a migration. Drives ask() terminology (DM/GM/Keeper) and, later, scopes the
  // rules-lookup corpus. "2014 vs 2024" is just two values → two SRD corpora.
  gameSystem String   @default("dnd-2014")
  theme      String   @default("firelight") // preset key; see the design track
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships     Membership[]
  parties         Party[]
  characters      Character[]
  gameSessions    GameSession[]
  knowledgeUnits  KnowledgeUnit[]
  sourceDocuments SourceDocument[]
  documentChunks  DocumentChunk[]
  assets          Asset[]
  askLogs         AskLog[]
  corrections     Correction[]
  shareRequests   ShareRequest[]
  discord         CampaignDiscord?
}

/// Binds a campaign to one Discord server — the multi-tenancy hinge. The bot resolves which
/// campaign an interaction belongs to from its `guildId`, so a single deployment can serve
/// many tables without any campaign id in the environment. Per-server settings that used to
/// be env vars (the reveals channel) live here too.
model CampaignDiscord {
  id              String   @id @default(cuid())
  campaignId      String   @unique
  guildId         String   @unique
  revealChannelId String? // default channel for /reveal + /npc share
  voiceChannelId  String? // preferred capture channel (advisory)
  createdAt       DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

/// A person. Auth.js will extend this table later; minimal for Phase 0.
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  // Links a Discord account to this person, so the bot can resolve who's asking.
  // Set manually now; later populated automatically by Discord login / DM roster.
  discordUserId String?  @unique
  createdAt     DateTime @default(now())

  memberships Membership[]
}

/// A user's seat in one campaign, with a role.
model Membership {
  id          String     @id @default(cuid())
  userId      String
  campaignId  String
  role        MemberRole
  // What to call this member AT THIS TABLE — the DM's name in transcripts, chosen during
  // /setup. Campaign-scoped on purpose: one person can DM several campaigns under different
  // names, and a global name would let a later /setup relabel an earlier campaign's history.
  displayName String?
  createdAt   DateTime   @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  characters          Character[]
  grantsRevealed      KnowledgeGrant[] @relation("GrantRevealedBy")
  revealEvents        RevealEvent[]    @relation("RevealBy")
  authoredNotes       KnowledgeUnit[]  @relation("NoteAuthor")
  correctionsProposed Correction[]     @relation("CorrectionProposedBy")
  correctionsReviewed Correction[]     @relation("CorrectionReviewedBy")
  sharesProposed      ShareRequest[]   @relation("ShareProposedBy")
  sharesReviewed      ShareRequest[]   @relation("ShareReviewedBy")

  @@unique([userId, campaignId])
  @@index([campaignId])
}

/// A group of characters. Latent for a single table (one party), but modeled so
/// reveals can target "the party" and split-party is a cheap future upgrade.
model Party {
  id         String @id @default(cuid())
  campaignId String
  name       String

  campaign      Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  characters    Character[]
  grants        KnowledgeGrant[] @relation("GrantParty")
  revealEvents  RevealEvent[]    @relation("RevealParty")
  shareRequests ShareRequest[]   @relation("SharedWithParty")

  @@index([campaignId])
}

/// A player's PC — the knowledge-owner viewpoint. Sheet fields are display-only.
model Character {
  id           String  @id @default(cuid())
  campaignId   String
  membershipId String
  partyId      String?
  name         String

  // light, display-only sheet — no dice/HP/combat logic
  ancestry  String?
  class     String?
  level     Int             @default(1)
  pronouns  String?
  status    CharacterStatus @default(ACTIVE)
  avatarUrl String?
  bio       String?
  stats     Json? // ability scores etc., purely for display

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  party      Party?     @relation(fields: [partyId], references: [id], onDelete: SetNull)

  grants             KnowledgeGrant[]    @relation("GrantCharacter")
  revealEvents       RevealEvent[]       @relation("RevealCharacter")
  audioClips         AudioClip[]
  transcriptSegments TranscriptSegment[]
  sessionAttendance  SessionAttendance[]

  @@index([campaignId])
  @@index([membershipId])
  @@index([partyId])
}

/// A game session. Empty until Phase 2 (capture) — created now so SESSION
/// provenance and the Auth.js `Session` naming collision are both handled early.
model GameSession {
  id             String            @id @default(cuid())
  campaignId     String
  number         Int
  title          String?
  occurredAt     DateTime?
  status         GameSessionStatus @default(COMPLETE)
  recap          String? // prose summary written by extraction; also feeds the timeline
  // Last time this session saw activity (a /record or /stop). Drives the merge window —
  // a /record within the window resumes this session — and the auto-finalize timeout.
  lastActivityAt DateTime?
  createdAt      DateTime          @default(now())

  campaign       Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  knowledgeUnits KnowledgeUnit[]
  // One session can own MANY recordings — a break-stop-restart adds another Recording to the
  // same session rather than starting a new one. Transcript = all recordings' clips by time.
  recordings     Recording[]
  attendance     SessionAttendance[]

  @@unique([campaignId, number])
  @@index([campaignId])
}

// ─── The memory (the spine) ──────────────────────────────────────────────────

/// The atom of campaign memory. A RELATIONSHIP unit links two others via
/// subject/object, so the relationship graph rides on the same filter for free.
model KnowledgeUnit {
  id             String          @id @default(cuid())
  campaignId     String
  type           KnowledgeType
  source         KnowledgeSource
  origin         KnowledgeOrigin @default(PLAYED)
  baseVisibility BaseVisibility
  title          String
  content        String

  // Semantic-search embedding (Voyage, 1024-dim). Written on create; similarity
  // search runs via raw SQL ($queryRaw) — Prisma can't express pgvector's `<=>`.
  embedding Unsupported("vector(1024)")?

  // provenance
  gameSessionId      String?
  sourceDocumentId   String? // set for DM_ADDED units extracted from an uploaded doc
  authorMembershipId String? // set for PLAYER_NOTE journal entries — who wrote it
  imageStoragePath   String? // set for GENERATED NPCs — the matched portrait's key

  // Set when an approved correction supersedes this unit: retrieval skips it, so a fact the
  // table has disowned can never be answered with again. Kept (not deleted) so the audit trail
  // still points at something real.
  supersededByCorrectionId String?

  // relationships-as-knowledge (self references)
  subjectId String?
  objectId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign         Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  gameSession      GameSession?    @relation(fields: [gameSessionId], references: [id], onDelete: SetNull)
  sourceDocument   SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  authorMembership Membership?     @relation("NoteAuthor", fields: [authorMembershipId], references: [id], onDelete: Cascade)

  subject   KnowledgeUnit?  @relation("SubjectRel", fields: [subjectId], references: [id], onDelete: SetNull)
  subjectOf KnowledgeUnit[] @relation("SubjectRel")
  object    KnowledgeUnit?  @relation("ObjectRel", fields: [objectId], references: [id], onDelete: SetNull)
  objectOf  KnowledgeUnit[] @relation("ObjectRel")

  grants                 KnowledgeGrant[]
  revealEvents           RevealEvent[]
  shareRequests          ShareRequest[]
  supersededByCorrection Correction?      @relation("Superseded", fields: [supersededByCorrectionId], references: [id], onDelete: SetNull)
  correctionResultOf     Correction?      @relation("CorrectionResult")

  @@index([campaignId, baseVisibility])
  @@index([campaignId, type])
  @@index([gameSessionId])
  @@index([sourceDocumentId])
  @@index([authorMembershipId])
  @@index([subjectId])
  @@index([objectId])
  @@index([supersededByCorrectionId])
}

/// A targeted reveal — the CURRENT state the filter reads. A DM_ONLY unit with a
/// grant to a character/party becomes visible to exactly them.
model KnowledgeGrant {
  id                     String   @id @default(cuid())
  // The grant targets exactly ONE of: a knowledge unit, a document chunk, or a whole
  // document (a document grant opens all its chunks — the "party finds a dossier" case).
  // "Exactly one target, exactly one scope" is enforced in revealTo().
  knowledgeUnitId        String?
  documentChunkId        String?
  sourceDocumentId       String?
  // The target IS the scope: exactly one of characterId / partyId is set.
  characterId            String?
  partyId                String?
  revealedByMembershipId String
  revealedAt             DateTime @default(now())

  knowledgeUnit  KnowledgeUnit?  @relation(fields: [knowledgeUnitId], references: [id], onDelete: Cascade)
  documentChunk  DocumentChunk?  @relation(fields: [documentChunkId], references: [id], onDelete: Cascade)
  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  character      Character?      @relation("GrantCharacter", fields: [characterId], references: [id], onDelete: Cascade)
  party          Party?          @relation("GrantParty", fields: [partyId], references: [id], onDelete: Cascade)
  revealedBy     Membership      @relation("GrantRevealedBy", fields: [revealedByMembershipId], references: [id])

  // A given target can be granted to a given character or party at most once.
  @@unique([knowledgeUnitId, characterId])
  @@unique([knowledgeUnitId, partyId])
  @@unique([documentChunkId, characterId])
  @@unique([documentChunkId, partyId])
  @@unique([sourceDocumentId, characterId])
  @@unique([sourceDocumentId, partyId])
  @@index([knowledgeUnitId])
  @@index([documentChunkId])
  @@index([sourceDocumentId])
  @@index([characterId])
  @@index([partyId])
}

/// Append-only audit of every visibility change — the history behind
/// "reveal in pieces," and the source for the DM dashboard's reveal log.
model RevealEvent {
  id               String          @id @default(cuid())
  // Same polymorphic target as KnowledgeGrant (unit | chunk | document).
  knowledgeUnitId  String?
  documentChunkId  String?
  sourceDocumentId String?
  action           RevealAction
  scope            GrantScope?
  characterId      String?
  partyId          String?
  fromVisibility   BaseVisibility?
  toVisibility     BaseVisibility?
  byMembershipId   String
  note             String?
  createdAt        DateTime        @default(now())

  knowledgeUnit  KnowledgeUnit?  @relation(fields: [knowledgeUnitId], references: [id], onDelete: Cascade)
  documentChunk  DocumentChunk?  @relation(fields: [documentChunkId], references: [id], onDelete: SetNull)
  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  character      Character?      @relation("RevealCharacter", fields: [characterId], references: [id], onDelete: SetNull)
  party          Party?          @relation("RevealParty", fields: [partyId], references: [id], onDelete: SetNull)
  by             Membership      @relation("RevealBy", fields: [byMembershipId], references: [id])

  @@index([knowledgeUnitId])
  @@index([documentChunkId])
  @@index([sourceDocumentId])
}

// ─── Capture (Phase 2) ───────────────────────────────────────────────────────

enum RecordingStatus {
  CAPTURING
  TRANSCRIBING
  DONE
  FAILED
}

/// One recording per game session — the container, plus the derived playback mix.
model Recording {
  id             String          @id @default(cuid())
  gameSessionId  String // NOT unique — a session can have many recordings (stop/restart segments)
  status         RecordingStatus @default(CAPTURING)
  startedAt      DateTime        @default(now())
  endedAt        DateTime?
  mixStoragePath String? // offline ffmpeg mix for session playback (Phase 5)
  createdAt      DateTime        @default(now())

  gameSession GameSession         @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  clips       AudioClip[]
  segments    TranscriptSegment[]

  @@index([gameSessionId])
}

/// One speaking burst's retained audio (compressed, in Supabase Storage).
model AudioClip {
  id            String    @id @default(cuid())
  recordingId   String
  characterId   String? // resolved speaker; null if unmapped
  discordUserId String // raw speaker id (provenance / fallback)
  storagePath   String // Supabase Storage object path
  startMs       Int // offset from session start
  durationMs    Int
  codec         String    @default("opus")
  // Set when the worker has processed this clip (text OR silence). A recording is
  // fully transcribed — and extraction can fire — once no clip has this null.
  transcribedAt DateTime?
  createdAt     DateTime  @default(now())

  recording Recording          @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  character Character?         @relation(fields: [characterId], references: [id], onDelete: SetNull)
  segment   TranscriptSegment?

  @@index([recordingId])
  @@index([characterId])
}

/// The transcript of one speaking burst — the source for SESSION knowledge units.
/// The session transcript is these, ordered by startMs (no audio stitching).
model TranscriptSegment {
  id            String   @id @default(cuid())
  recordingId   String
  audioClipId   String?  @unique
  characterId   String?
  discordUserId String
  startMs       Int
  endMs         Int
  text          String
  createdAt     DateTime @default(now())

  recording Recording  @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  audioClip AudioClip? @relation(fields: [audioClipId], references: [id], onDelete: SetNull)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@index([recordingId, startMs])
  @@index([characterId])
}

/// Who was present in the session's voice channel (split-party + spotlight later).
model SessionAttendance {
  id            String    @id @default(cuid())
  gameSessionId String
  characterId   String?
  discordUserId String
  joinedAt      DateTime  @default(now())
  leftAt        DateTime?

  gameSession GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  character   Character?  @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@unique([gameSessionId, discordUserId])
  @@index([gameSessionId])
}

// ─── DM inputs (Phase 3) ─────────────────────────────────────────────────────

enum SourceType {
  UPLOAD // DM dragged a file in — we hold the raw (documents bucket)
  DISCORD // ingested from a Discord channel/attachment
  DRIVE
  NOTION
  ONENOTE
}

enum DocumentStatus {
  PENDING // created, not yet parsed
  PARSING
  PARSED // chunked + embedded, ready
  FAILED
}

/// A DM-provided source — an uploaded file OR a synced/linked original — plus its
/// provenance. Doubles as the DM's "library" (a list of everything they've fed in).
/// Its text is split into DocumentChunks for retrieval.
model SourceDocument {
  id           String         @id @default(cuid())
  campaignId   String
  name         String
  sourceType   SourceType     @default(UPLOAD)
  // Uploaded raw file lives in the `documents` bucket (storagePath); a synced source
  // instead keeps a link back to the original (sourceUrl) — never both.
  storagePath  String?
  sourceUrl    String?
  mimeType     String?
  status       DocumentStatus @default(PENDING)
  // Whether to also extract structured DM_ADDED KnowledgeUnits from this doc (a Claude
  // call). On for a single manual upload; bulk connectors set it off (cost-gated).
  extractUnits Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  campaign       Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  chunks         DocumentChunk[]
  knowledgeUnits KnowledgeUnit[]
  grants         KnowledgeGrant[] // document-level reveals (opens all its chunks)
  reveals        RevealEvent[]

  @@index([campaignId])
}

/// One chunk of a SourceDocument's text, embedded for semantic search (the RAG layer).
/// Visibility defaults to DM_ONLY (the DM's private prep); a player-visible source (e.g.
/// a public Discord channel) sets EVERYONE. Reveal to players via a chunk- or
/// document-level grant — that polymorphic grant/reveal ships with Phase 3's reveal bite;
/// see docs/data-model.md. Retrieval filters chunks by the SAME permission rules as units.
model DocumentChunk {
  id                       String         @id @default(cuid())
  sourceDocumentId         String
  campaignId               String
  chunkIndex               Int
  text                     String
  baseVisibility           BaseVisibility @default(DM_ONLY)
  /// Set when an approved correction retires this passage. /ask retrieves document passages as
  /// well as facts, so without this a corrected mistake still grounds answers from the original
  /// upload. A passage is retired rather than rewritten — the document is its source of truth,
  /// and the correction carries the truth as its own fact.
  supersededByCorrectionId String?

  // Voyage 1024-dim, same as KnowledgeUnit; similarity search via raw SQL ($queryRaw).
  embedding Unsupported("vector(1024)")?

  createdAt DateTime @default(now())

  sourceDocument SourceDocument   @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  campaign       Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  grants         KnowledgeGrant[] // chunk-level reveals
  reveals        RevealEvent[]

  @@unique([sourceDocumentId, chunkIndex])
  @@index([campaignId, baseVisibility])
  @@index([sourceDocumentId])
  @@index([supersededByCorrectionId])
}

/// A reusable media asset — NPC portraits/tokens today (maps/handouts later). Embedded for
/// similarity matching (voyage-multimodal-3, 1024-dim), so a generated NPC can be paired with
/// its nearest-vibe portrait. `campaignId` null = the shared pool Hearth ships; set = a DM's
/// own uploads. `kind` is a preset key (not an enum) so new asset kinds need no migration.
model Asset {
  id          String                       @id @default(cuid())
  campaignId  String?
  kind        String                       @default("portrait")
  label       String
  storagePath String                       @unique
  embedding   Unsupported("vector(1024)")?
  createdAt   DateTime                     @default(now())

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, kind])
}

/// A logged /ask — question, answer, and who asked — so a player can later review their ask
/// history (web report) and so the responses can be evaluated in-house. Attribution ids are
/// plain columns (no FK to Membership/Character) to keep those models uncluttered; only the
/// campaign link cascades. `sources` is the JSON list the answer drew on. Written best-effort.
model AskLog {
  id                  String   @id @default(cuid())
  campaignId          String
  askedByMembershipId String?
  characterId         String?
  role                String
  question            String
  answer              String
  sources             Json
  gameSessionId       String?
  createdAt           DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([campaignId, characterId])
}

enum CorrectionStatus {
  PENDING // waiting on the DM
  APPROVED // applied to canon
  REJECTED // the DM said the memory was right
}

/// A proposed fix to something the memory got wrong.
///
/// Corrections are their own durable records rather than edits to the offending unit, because
/// extraction is destructive: finalizing a session deletes and recreates its SESSION units, so
/// an in-place edit would silently vanish on the next run. Instead an approved correction
/// creates its own authoritative unit and marks what it supersedes.
///
/// The DM owns canon, so a player's correction only takes effect once approved — the same
/// propose→approve shape as a reveal, just player-initiated.
model Correction {
  id         String           @id @default(cuid())
  campaignId String
  status     CorrectionStatus @default(PENDING)

  /// What the table says is actually true, in their own words.
  statement String
  /// Optionally what the memory said — helps the DM judge, and names the mistake in the audit.
  wasWrong  String?

  /// Nullable on purpose: a correction must OUTLIVE whoever proposed it. Cascading from the
  /// membership would delete the correction when a player leaves, which sets the units it
  /// retired back to live — resurrecting facts the table already disowned.
  proposedByMembershipId String?
  reviewedByMembershipId String?
  reviewedAt             DateTime?
  /// Why the DM rejected it, shown back to whoever proposed it.
  reviewNote             String?

  /// What this proposes to retire, and the fact that replaces it — resolved when the correction
  /// is PROPOSED, not when it's approved, so the DM applies exactly what they were shown rather
  /// than whatever a second model pass would decide later.
  /// Deliberately plain ids, not a relation: extraction deletes and recreates SESSION units, so
  /// a foreign key here would either block that or cascade away the record of what was retired.
  targetUnitIds String[]
  /// Per-target corrected text: [{ id, rewrite }]. A correction REPLACES the facts it touches
  /// rather than deleting them, because a wrong fact is usually mostly right — retiring
  /// "Moraine, daughter of Morwyn and his wife Moira" outright would also lose Moraine.
  rewrites      Json?
  /// An additional fact, only when the rewrites don't already state what the correction says.
  resultTitle   String?
  resultContent String?

  /// The authoritative unit created on approval (null while pending/rejected).
  resultUnitId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  proposedBy Membership?     @relation("CorrectionProposedBy", fields: [proposedByMembershipId], references: [id], onDelete: SetNull)
  reviewedBy Membership?     @relation("CorrectionReviewedBy", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)
  resultUnit KnowledgeUnit?  @relation("CorrectionResult", fields: [resultUnitId], references: [id], onDelete: SetNull)
  /// Units this correction retired.
  superseded KnowledgeUnit[] @relation("Superseded")

  @@index([campaignId, status])
  @@index([proposedByMembershipId])
}

enum ShareStatus {
  PENDING // waiting on the DM
  APPROVED // granted to the party
  REJECTED // the DM kept it private
}

/// A player asking to tell the party something they know.
///
/// The same shape as a Correction — propose, the DM approves, it lands in shared memory — but
/// deliberately its own table rather than one row type with a `kind` column: the payloads have
/// nothing in common (a correction carries rewrites and targets, a share carries one unit), and
/// merging them would mean a row where most columns are null for any given kind.
///
/// The permission spine bounds this for free: the unit is chosen through filtered retrieval, so
/// a player can only offer to share something they can already see.
model ShareRequest {
  id              String      @id @default(cuid())
  campaignId      String
  knowledgeUnitId String
  status          ShareStatus @default(PENDING)
  /// What the player wants the party to understand about it, in their words.
  note            String?

  /// Who it goes to, resolved when the share is REQUESTED rather than at approval — so the DM
  /// approves exactly the audience they were shown, and a player who changes party in the
  /// meantime can't silently redirect it.
  partyId String?

  /// Nullable for the same reason as a Correction's: the record of what was shared must
  /// outlive the member who shared it.
  proposedByMembershipId String?
  reviewedByMembershipId String?
  reviewedAt             DateTime?
  reviewNote             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign      Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  knowledgeUnit KnowledgeUnit @relation(fields: [knowledgeUnitId], references: [id], onDelete: Cascade)
  party         Party?        @relation("SharedWithParty", fields: [partyId], references: [id], onDelete: SetNull)
  proposedBy    Membership?   @relation("ShareProposedBy", fields: [proposedByMembershipId], references: [id], onDelete: SetNull)
  reviewedBy    Membership?   @relation("ShareReviewedBy", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([knowledgeUnitId])
}
