// Hearth — campaign memory schema (Phase 0: the permission spine).
//
// Design notes live in docs/data-model.md. This migration ships identity +
// tenancy (partial) and the memory core. Transcripts, embeddings, recaps, maps,
// billing, etc. are added additively in their phases — this file is a deliberate
// SUBSET of that full model, not the whole thing.
//
// pgvector (embeddings) is intentionally NOT here yet — it arrives in Phase 1
// with retrieval, to keep this first migration clean on Supabase.

generator client {
  provider = "prisma-client" // Prisma 7 generator (no binary engine)
  output   = "../src/generated/prisma" // generates into the repo, not node_modules
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
  // Connection URLs live in prisma.config.ts (Prisma 7). At runtime the client
  // connects via the pg driver adapter using DATABASE_URL (pooled) directly.
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum MemberRole {
  DM
  PLAYER
}

/// Where a piece of knowledge came from — drives the two-tier permission rule.
enum KnowledgeSource {
  SESSION // happened at the table — fair game to the campaign
  DM_ADDED // authored/uploaded by the DM — gated until revealed
}

/// How a DM_ADDED unit originated (provenance/trust). SESSION units are PLAYED.
enum KnowledgeOrigin {
  PLAYED
  AUTHORED
  GENERATED // NPC generator & friends
}

/// The broad visibility. Targeted reveals (party/character) live in KnowledgeGrant,
/// so there is a single source of truth. PUBLIC is reserved, unused today.
enum BaseVisibility {
  DM_ONLY
  EVERYONE
  PUBLIC
}

enum KnowledgeType {
  NPC
  LOCATION
  EVENT
  FACT
  LORE
  ITEM
  RELATIONSHIP // links two other units via subject/object
  THREAD // an open question / dangling plot
}

enum GrantScope {
  CHARACTER
  PARTY
}

enum RevealAction {
  REVEAL
  REVOKE
  CHANGE_VISIBILITY
}

enum CharacterStatus {
  ACTIVE
  RETIRED
  DEAD
}

enum GameSessionStatus {
  PLANNED
  ACTIVE
  COMPLETE
}

// ─── Identity & tenancy ──────────────────────────────────────────────────────

model Campaign {
  id         String   @id @default(cuid())
  name       String
  // Which TTRPG this table plays — a preset key, not an enum, so new systems don't
  // need a migration. Drives ask() terminology (DM/GM/Keeper) and, later, scopes the
  // rules-lookup corpus. "2014 vs 2024" is just two values → two SRD corpora.
  gameSystem String   @default("dnd-2014")
  theme      String   @default("firelight") // preset key; see the design track
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships     Membership[]
  parties         Party[]
  characters      Character[]
  gameSessions    GameSession[]
  knowledgeUnits  KnowledgeUnit[]
  sourceDocuments SourceDocument[]
  documentChunks  DocumentChunk[]
}

/// A person. Auth.js will extend this table later; minimal for Phase 0.
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  // Links a Discord account to this person, so the bot can resolve who's asking.
  // Set manually now; later populated automatically by Discord login / DM roster.
  discordUserId String?  @unique
  createdAt     DateTime @default(now())

  memberships Membership[]
}

/// A user's seat in one campaign, with a role.
model Membership {
  id         String     @id @default(cuid())
  userId     String
  campaignId String
  role       MemberRole
  createdAt  DateTime   @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  characters     Character[]
  grantsRevealed KnowledgeGrant[] @relation("GrantRevealedBy")
  revealEvents   RevealEvent[]    @relation("RevealBy")

  @@unique([userId, campaignId])
  @@index([campaignId])
}

/// A group of characters. Latent for a single table (one party), but modeled so
/// reveals can target "the party" and split-party is a cheap future upgrade.
model Party {
  id         String @id @default(cuid())
  campaignId String
  name       String

  campaign     Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  characters   Character[]
  grants       KnowledgeGrant[] @relation("GrantParty")
  revealEvents RevealEvent[]    @relation("RevealParty")

  @@index([campaignId])
}

/// A player's PC — the knowledge-owner viewpoint. Sheet fields are display-only.
model Character {
  id           String  @id @default(cuid())
  campaignId   String
  membershipId String
  partyId      String?
  name         String

  // light, display-only sheet — no dice/HP/combat logic
  ancestry  String?
  class     String?
  level     Int             @default(1)
  pronouns  String?
  status    CharacterStatus @default(ACTIVE)
  avatarUrl String?
  bio       String?
  stats     Json? // ability scores etc., purely for display

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  party      Party?     @relation(fields: [partyId], references: [id], onDelete: SetNull)

  grants             KnowledgeGrant[]    @relation("GrantCharacter")
  revealEvents       RevealEvent[]       @relation("RevealCharacter")
  audioClips         AudioClip[]
  transcriptSegments TranscriptSegment[]
  sessionAttendance  SessionAttendance[]

  @@index([campaignId])
  @@index([membershipId])
  @@index([partyId])
}

/// A game session. Empty until Phase 2 (capture) — created now so SESSION
/// provenance and the Auth.js `Session` naming collision are both handled early.
model GameSession {
  id         String            @id @default(cuid())
  campaignId String
  number     Int
  title      String?
  occurredAt DateTime?
  status     GameSessionStatus @default(COMPLETE)
  recap      String? // prose summary written by extraction; also feeds the timeline
  createdAt  DateTime          @default(now())

  campaign       Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  knowledgeUnits KnowledgeUnit[]
  recording      Recording?
  attendance     SessionAttendance[]

  @@unique([campaignId, number])
  @@index([campaignId])
}

// ─── The memory (the spine) ──────────────────────────────────────────────────

/// The atom of campaign memory. A RELATIONSHIP unit links two others via
/// subject/object, so the relationship graph rides on the same filter for free.
model KnowledgeUnit {
  id             String          @id @default(cuid())
  campaignId     String
  type           KnowledgeType
  source         KnowledgeSource
  origin         KnowledgeOrigin @default(PLAYED)
  baseVisibility BaseVisibility
  title          String
  content        String

  // Semantic-search embedding (Voyage, 1024-dim). Written on create; similarity
  // search runs via raw SQL ($queryRaw) — Prisma can't express pgvector's `<=>`.
  embedding Unsupported("vector(1024)")?

  // provenance
  gameSessionId    String?
  sourceDocumentId String? // set for DM_ADDED units extracted from an uploaded doc

  // relationships-as-knowledge (self references)
  subjectId String?
  objectId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign       Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  gameSession    GameSession?    @relation(fields: [gameSessionId], references: [id], onDelete: SetNull)
  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)

  subject   KnowledgeUnit?  @relation("SubjectRel", fields: [subjectId], references: [id], onDelete: SetNull)
  subjectOf KnowledgeUnit[] @relation("SubjectRel")
  object    KnowledgeUnit?  @relation("ObjectRel", fields: [objectId], references: [id], onDelete: SetNull)
  objectOf  KnowledgeUnit[] @relation("ObjectRel")

  grants       KnowledgeGrant[]
  revealEvents RevealEvent[]

  @@index([campaignId, baseVisibility])
  @@index([campaignId, type])
  @@index([gameSessionId])
  @@index([sourceDocumentId])
  @@index([subjectId])
  @@index([objectId])
}

/// A targeted reveal — the CURRENT state the filter reads. A DM_ONLY unit with a
/// grant to a character/party becomes visible to exactly them.
model KnowledgeGrant {
  id                     String   @id @default(cuid())
  // The grant targets exactly ONE of: a knowledge unit, a document chunk, or a whole
  // document (a document grant opens all its chunks — the "party finds a dossier" case).
  // "Exactly one target, exactly one scope" is enforced in revealTo().
  knowledgeUnitId        String?
  documentChunkId        String?
  sourceDocumentId       String?
  // The target IS the scope: exactly one of characterId / partyId is set.
  characterId            String?
  partyId                String?
  revealedByMembershipId String
  revealedAt             DateTime @default(now())

  knowledgeUnit  KnowledgeUnit?  @relation(fields: [knowledgeUnitId], references: [id], onDelete: Cascade)
  documentChunk  DocumentChunk?  @relation(fields: [documentChunkId], references: [id], onDelete: Cascade)
  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  character      Character?      @relation("GrantCharacter", fields: [characterId], references: [id], onDelete: Cascade)
  party          Party?          @relation("GrantParty", fields: [partyId], references: [id], onDelete: Cascade)
  revealedBy     Membership      @relation("GrantRevealedBy", fields: [revealedByMembershipId], references: [id])

  // A given target can be granted to a given character or party at most once.
  @@unique([knowledgeUnitId, characterId])
  @@unique([knowledgeUnitId, partyId])
  @@unique([documentChunkId, characterId])
  @@unique([documentChunkId, partyId])
  @@unique([sourceDocumentId, characterId])
  @@unique([sourceDocumentId, partyId])
  @@index([knowledgeUnitId])
  @@index([documentChunkId])
  @@index([sourceDocumentId])
  @@index([characterId])
  @@index([partyId])
}

/// Append-only audit of every visibility change — the history behind
/// "reveal in pieces," and the source for the DM dashboard's reveal log.
model RevealEvent {
  id               String          @id @default(cuid())
  // Same polymorphic target as KnowledgeGrant (unit | chunk | document).
  knowledgeUnitId  String?
  documentChunkId  String?
  sourceDocumentId String?
  action           RevealAction
  scope            GrantScope?
  characterId      String?
  partyId          String?
  fromVisibility   BaseVisibility?
  toVisibility     BaseVisibility?
  byMembershipId   String
  note             String?
  createdAt        DateTime        @default(now())

  knowledgeUnit  KnowledgeUnit?  @relation(fields: [knowledgeUnitId], references: [id], onDelete: Cascade)
  documentChunk  DocumentChunk?  @relation(fields: [documentChunkId], references: [id], onDelete: SetNull)
  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  character      Character?      @relation("RevealCharacter", fields: [characterId], references: [id], onDelete: SetNull)
  party          Party?          @relation("RevealParty", fields: [partyId], references: [id], onDelete: SetNull)
  by             Membership      @relation("RevealBy", fields: [byMembershipId], references: [id])

  @@index([knowledgeUnitId])
  @@index([documentChunkId])
  @@index([sourceDocumentId])
}

// ─── Capture (Phase 2) ───────────────────────────────────────────────────────

enum RecordingStatus {
  CAPTURING
  TRANSCRIBING
  DONE
  FAILED
}

/// One recording per game session — the container, plus the derived playback mix.
model Recording {
  id             String          @id @default(cuid())
  gameSessionId  String          @unique
  status         RecordingStatus @default(CAPTURING)
  startedAt      DateTime        @default(now())
  endedAt        DateTime?
  mixStoragePath String? // offline ffmpeg mix for session playback (Phase 5)
  createdAt      DateTime        @default(now())

  gameSession GameSession         @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  clips       AudioClip[]
  segments    TranscriptSegment[]
}

/// One speaking burst's retained audio (compressed, in Supabase Storage).
model AudioClip {
  id            String    @id @default(cuid())
  recordingId   String
  characterId   String? // resolved speaker; null if unmapped
  discordUserId String // raw speaker id (provenance / fallback)
  storagePath   String // Supabase Storage object path
  startMs       Int // offset from session start
  durationMs    Int
  codec         String    @default("opus")
  // Set when the worker has processed this clip (text OR silence). A recording is
  // fully transcribed — and extraction can fire — once no clip has this null.
  transcribedAt DateTime?
  createdAt     DateTime  @default(now())

  recording Recording          @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  character Character?         @relation(fields: [characterId], references: [id], onDelete: SetNull)
  segment   TranscriptSegment?

  @@index([recordingId])
  @@index([characterId])
}

/// The transcript of one speaking burst — the source for SESSION knowledge units.
/// The session transcript is these, ordered by startMs (no audio stitching).
model TranscriptSegment {
  id            String   @id @default(cuid())
  recordingId   String
  audioClipId   String?  @unique
  characterId   String?
  discordUserId String
  startMs       Int
  endMs         Int
  text          String
  createdAt     DateTime @default(now())

  recording Recording  @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  audioClip AudioClip? @relation(fields: [audioClipId], references: [id], onDelete: SetNull)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@index([recordingId, startMs])
  @@index([characterId])
}

/// Who was present in the session's voice channel (split-party + spotlight later).
model SessionAttendance {
  id            String    @id @default(cuid())
  gameSessionId String
  characterId   String?
  discordUserId String
  joinedAt      DateTime  @default(now())
  leftAt        DateTime?

  gameSession GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  character   Character?  @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@unique([gameSessionId, discordUserId])
  @@index([gameSessionId])
}

// ─── DM inputs (Phase 3) ─────────────────────────────────────────────────────

enum SourceType {
  UPLOAD // DM dragged a file in — we hold the raw (documents bucket)
  DISCORD // ingested from a Discord channel/attachment
  DRIVE
  NOTION
  ONENOTE
}

enum DocumentStatus {
  PENDING // created, not yet parsed
  PARSING
  PARSED // chunked + embedded, ready
  FAILED
}

/// A DM-provided source — an uploaded file OR a synced/linked original — plus its
/// provenance. Doubles as the DM's "library" (a list of everything they've fed in).
/// Its text is split into DocumentChunks for retrieval.
model SourceDocument {
  id           String         @id @default(cuid())
  campaignId   String
  name         String
  sourceType   SourceType     @default(UPLOAD)
  // Uploaded raw file lives in the `documents` bucket (storagePath); a synced source
  // instead keeps a link back to the original (sourceUrl) — never both.
  storagePath  String?
  sourceUrl    String?
  mimeType     String?
  status       DocumentStatus @default(PENDING)
  // Whether to also extract structured DM_ADDED KnowledgeUnits from this doc (a Claude
  // call). On for a single manual upload; bulk connectors set it off (cost-gated).
  extractUnits Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  campaign       Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  chunks         DocumentChunk[]
  knowledgeUnits KnowledgeUnit[]
  grants         KnowledgeGrant[] // document-level reveals (opens all its chunks)
  reveals        RevealEvent[]

  @@index([campaignId])
}

/// One chunk of a SourceDocument's text, embedded for semantic search (the RAG layer).
/// Visibility defaults to DM_ONLY (the DM's private prep); a player-visible source (e.g.
/// a public Discord channel) sets EVERYONE. Reveal to players via a chunk- or
/// document-level grant — that polymorphic grant/reveal ships with Phase 3's reveal bite;
/// see docs/data-model.md. Retrieval filters chunks by the SAME permission rules as units.
model DocumentChunk {
  id               String         @id @default(cuid())
  sourceDocumentId String
  campaignId       String
  chunkIndex       Int
  text             String
  baseVisibility   BaseVisibility @default(DM_ONLY)

  // Voyage 1024-dim, same as KnowledgeUnit; similarity search via raw SQL ($queryRaw).
  embedding Unsupported("vector(1024)")?

  createdAt DateTime @default(now())

  sourceDocument SourceDocument   @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  campaign       Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  grants         KnowledgeGrant[] // chunk-level reveals
  reveals        RevealEvent[]

  @@unique([sourceDocumentId, chunkIndex])
  @@index([campaignId, baseVisibility])
  @@index([sourceDocumentId])
}
