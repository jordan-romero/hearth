# ─── Hearth environment (copy to .env, never commit real values) ─────────────
# Each variable is annotated with the phase it first becomes necessary, so you
# only fill them in as you reach them.

# ── Database (Supabase) — Phase 0 ───────────────────────────────────────────
# Pooled connection (port 6543) — used by serverless code on Vercel + Prisma queries.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used for migrations and by the always-on worker (pg-boss LISTEN/NOTIFY).
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres"

# ── Auth.js — Phase 1 (web) ─────────────────────────────────────────────────
AUTH_SECRET=""            # `openssl rand -base64 32`
AUTH_DISCORD_ID=""        # optional "Log in with Discord" button
AUTH_DISCORD_SECRET=""

# ── Claude — Phase 1 ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ── Discord bot — Phase 1/2 ─────────────────────────────────────────────────
DISCORD_BOT_TOKEN=""
DISCORD_CLIENT_ID=""

# ── Transcription (Groq Whisper, batch) — Phase 2 ───────────────────────────
GROQ_API_KEY=""

# ── Billing (Stripe) — Phase 6 ──────────────────────────────────────────────
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
