# ─── Hearth environment (copy to .env, never commit real values) ─────────────
# .env is gitignored. This file lists EVERY variable Hearth reads, with safe
# placeholders — fill it in per machine, or sync the real values via a secrets
# manager (see the note at the very bottom). Annotated with the phase each is
# first needed so you only fill them in as you reach them.

# ── Database (Supabase Postgres) — Phase 0 ──────────────────────────────────
# Pooled connection (port 6543) — serverless code + Prisma queries.
DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres?pgbouncer=true
# Direct connection (port 5432) — migrations + the always-on worker (pg-boss LISTEN/NOTIFY).
DIRECT_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres

# ── Supabase Storage (recordings / documents / portraits) — Phase 2/3 ───────
SUPABASE_URL=https://<ref>.supabase.co
# Service-role key: server-only, full access. NEVER expose to a browser/client.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# ── Claude (Anthropic) — Phase 1 ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Embeddings (Voyage) — Phase 1/3 (text + multimodal portrait matching) ───
VOYAGE_API_KEY=pa-...

# ── Transcription — Phase 2 ─────────────────────────────────────────────────
DEEPGRAM_API_KEY=<deepgram-api-key>   # current (Nova-3)
GROQ_API_KEY=gsk_...                  # legacy Whisper path — optional

# ── Discord bot — Phase 1/2 ─────────────────────────────────────────────────
DISCORD_BOT_TOKEN=<bot-token>
DISCORD_CLIENT_ID=<application-id>
DISCORD_GUILD_ID=<guild-id>           # your dev server — only used with HEARTH_GUILD_COMMANDS
HEARTH_GUILD_COMMANDS=0               # 1 = register commands to DISCORD_GUILD_ID only (instant,
                                      # dev). Default 0 = global, so EVERY server gets commands.

# Access gate — comma-separated Discord server ids allowed to use Hearth. Commands cost real
# money (Claude/Voyage/Deepgram) on our keys, so an unapproved server gets a polite refusal and
# spends nothing. EMPTY = every server the bot is in may use it. MUST be set before the bot is
# made public in the Discord dev portal.
HEARTH_ALLOWED_GUILDS=<guild-id>,<another-guild-id>

# ── Auth.js (web) — Phase 1 ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# (don't paste the line above as the value — the `#` makes dotenv silently truncate it)
AUTH_SECRET=
AUTH_URL=http://localhost:3100        # the app's own base URL; must match the Discord redirect
# The OAuth app IS the bot's application, so the id defaults to DISCORD_CLIENT_ID and you
# normally only need the secret: Developer Portal -> your app -> OAuth2 -> Client Secret.
# Also add a redirect there: <AUTH_URL>/api/auth/callback/discord
# AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# ── App config ──────────────────────────────────────────────────────────────
# A campaign is bound to a Discord server via /setup — there is no campaign id in the env.
# How long a stop/restart still counts as the same session (also the finalize delay).
# Fractional values are allowed: set 0.5 to exercise the session lifecycle in ~30 seconds.
# HEARTH_SESSION_GAP_MIN=30

# Live transcription (Phase 4b). Runs ALONGSIDE the batch path, never instead of it: batch
# rescores with the whole clip in context and is better on names, so it stays the record, while
# streaming makes a long monologue visible before the speaker stops. Deepgram bills streaming by
# connected time, so this costs more per session — leave off until you want it.
HEARTH_LIVE_TRANSCRIPTION=0

# ── DEV ONLY — must NEVER be set in production / on Railway ──────────────────
HEARTH_DEV_DM_TOGGLE=0                 # 1 enables /dmmode (view as the DM); keep OFF in prod

# ── Billing (Stripe) — Phase 6 ──────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
