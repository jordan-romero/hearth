{
  "name": "hearth",
  "version": "0.0.0",
  "private": true,
  "description": "Hearth — a D&D campaign memory you can talk to, permission-filtered per player.",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @hearth/db generate",
    "db:migrate": "pnpm --filter @hearth/db migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "turbo": "^2.5.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.62.1"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=6.27.0"
    }
  }
}
